 SocketServer/Program.cs
```cs

using System.Net;
using System.Net.Sockets;
using System.Text;

const int PORT = 5000;

Console.WriteLine("=== TCP SERVER ===");

// Создаём TCP-сокет с использованием IPv4.
Socket server = new Socket(
    AddressFamily.InterNetwork,
    SocketType.Stream,
    ProtocolType.Tcp
);

try
{
    // 1. Привязываем сервер к порту
    IPEndPoint endpoint = new IPEndPoint(
        IPAddress.Loopback,
        PORT
    );

    server.Bind(endpoint);

    // 2. Начинаем ожидать подключения
    server.Listen(10);

    Console.WriteLine($"Server started on port {PORT}");
    Console.WriteLine("Waiting for client...");

    // 3. Принимаем подключение
    // Метод `Accept()` блокирует выполнение программы до момента подключения клиента.
    // После подключения возвращается отдельный сокет для обмена данными с клиентом
    using Socket client = server.Accept();

    Console.WriteLine("Client connected!");
    Console.WriteLine($"Client address: {client.RemoteEndPoint}");

    // 4. Получаем данные
    using MemoryStream receivedData = new MemoryStream();

    byte[] buffer = new byte[1024];

    int received;
    
	// Сервер получает данные небольшими частями.
	// Когда клиент завершит отправку и выполнит `Shutdown(SocketShutdown.Send)`, сервер получит `0` при следующем чтении.
	// Мы собираем полученные части в `MemoryStream`, чтобы не потерять данные.
    while ((received = client.Receive(buffer)) > 0)
    {
        receivedData.Write(buffer, 0, received);
    }

    string message = Encoding.UTF8.GetString(
        receivedData.ToArray()
    );

    Console.WriteLine($"Received: {message}");

    // 5. Формируем ответ
    string response = $"Server received: {message}";

    byte[] responseData = Encoding.UTF8.GetBytes(response);

    // 6. Отправляем ответ полностью
    int sent = 0;

    while (sent < responseData.Length)
    {
	    // В нашей программе используется цикл, поскольку один вызов `Send()` не обязан отправлять весь переданный массив.
		// Это важная особенность TCP-сокетов.
        sent += client.Send(
            responseData,
            sent,
            responseData.Length - sent,
            SocketFlags.None
        );
    }

    Console.WriteLine("Response sent.");
}
catch (SocketException ex)
{
    Console.WriteLine($"Socket error: {ex.Message}");
}
catch (Exception ex)
{
    Console.WriteLine($"Error: {ex.Message}");
}
finally
{
    server.Close();
    Console.WriteLine("Server stopped.");
}
```

### Почему здесь используется MemoryStream?

TCP не знает, где заканчивается одно сообщение и начинается другое.
`MemoryStream` позволяет собрать все полученные байты в один массив, прежде чем преобразовать их в строку.
В этом учебном примере окончание отправки определяется закрытием направления передачи клиентом.
В реальных приложениях обычно применяются собственные правила разделения сообщений: например, длина сообщения в заголовке или специальный разделитель.
